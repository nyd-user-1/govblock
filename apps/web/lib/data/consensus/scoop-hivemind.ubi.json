{"slug":"scoop-hivemind.ubi","title":"Universal basic income","topic":"A Universal Basic Income for Aotearoa NZ?","description":"\"This HiveMind is  __*closed*__","source":"https://pol.is/4yy3sh84js","stats":{"views":234,"voters":234,"commenters":19,"statements":70,"groups":4,"votes":7153},"groups":[{"id":0,"size":70},{"id":1,"size":113},{"id":2,"size":42},{"id":3,"size":9}],"statements":[{"tid":35,"text":"I live in a rural area","moderated":1,"votes":{"agree":30,"disagree":120,"pass":14,"seen":164},"byGroup":{"0":{"agree":15,"disagree":51,"pass":4,"seen":70},"1":{"agree":6,"disagree":34,"pass":7,"seen":47},"2":{"agree":7,"disagree":30,"pass":1,"seen":38},"3":{"agree":2,"disagree":5,"pass":2,"seen":9}}},{"tid":33,"text":"I am 30 years of age or older but less than 55","moderated":1,"votes":{"agree":71,"disagree":77,"pass":16,"seen":164},"byGroup":{"0":{"agree":31,"disagree":35,"pass":4,"seen":70},"1":{"agree":17,"disagree":18,"pass":9,"seen":44},"2":{"agree":19,"disagree":21,"pass":1,"seen":41},"3":{"agree":4,"disagree":3,"pass":2,"seen":9}}},{"tid":6,"text":"The expense of a UBl should be offset by cuts to government funded services, such as healthcare, education, & childcare support.","moderated":1,"votes":{"agree":15,"disagree":135,"pass":12,"seen":162},"byGroup":{"0":{"agree":2,"disagree":63,"pass":5,"seen":70},"1":{"agree":8,"disagree":31,"pass":4,"seen":43},"2":{"agree":0,"disagree":38,"pass":2,"seen":40},"3":{"agree":5,"disagree":3,"pass":1,"seen":9}}},{"tid":3,"text":"We must ensure the political and economic upheaval of a transition to a universal basic income is not used by interest groups and idealogues to further subvert the welfare state.","moderated":1,"votes":{"agree":126,"disagree":10,"pass":26,"seen":162},"byGroup":{"0":{"agree":61,"disagree":2,"pass":7,"seen":70},"1":{"agree":27,"disagree":4,"pass":12,"seen":43},"2":{"agree":33,"disagree":2,"pass":5,"seen":40},"3":{"agree":5,"disagree":2,"pass":2,"seen":9}}},{"tid":36,"text":"I live in a town","moderated":1,"votes":{"agree":73,"disagree":68,"pass":20,"seen":161},"byGroup":{"0":{"agree":26,"disagree":35,"pass":9,"seen":70},"1":{"agree":21,"disagree":14,"pass":7,"seen":42},"2":{"agree":23,"disagree":15,"pass":2,"seen":40},"3":{"agree":3,"disagree":4,"pass":2,"seen":9}}},{"tid":11,"text":"A UBI would better fit within a Maori sense of collective social justice, and would assist the Crown to honour their commitments to Maori.","moderated":1,"votes":{"agree":101,"disagree":19,"pass":41,"seen":161},"byGroup":{"0":{"agree":54,"disagree":1,"pass":14,"seen":69},"1":{"agree":19,"disagree":7,"pass":17,"seen":43},"2":{"agree":27,"disagree":3,"pass":10,"seen":40},"3":{"agree":1,"disagree":8,"pass":0,"seen":9}}},{"tid":0,"text":"NZ needs a new system that better guarantees the welfare of the least well off and those facing insecure work conditions.","moderated":1,"votes":{"agree":152,"disagree":7,"pass":1,"seen":160},"byGroup":{"0":{"agree":70,"disagree":0,"pass":0,"seen":70},"1":{"agree":38,"disagree":3,"pass":0,"seen":41},"2":{"agree":40,"disagree":0,"pass":0,"seen":40},"3":{"agree":4,"disagree":4,"pass":1,"seen":9}}},{"tid":27,"text":"A UBI could contribute to the ‘degrowth’ agenda by promoting community development and more localised economies.","moderated":1,"votes":{"agree":114,"disagree":12,"pass":34,"seen":160},"byGroup":{"0":{"agree":62,"disagree":3,"pass":5,"seen":70},"1":{"agree":18,"disagree":4,"pass":18,"seen":40},"2":{"agree":32,"disagree":0,"pass":9,"seen":41},"3":{"agree":2,"disagree":5,"pass":2,"seen":9}}},{"tid":8,"text":"The elimination of the inefficiencies of the current benefit system would at least partially offset spending required for a UBI.\n","moderated":1,"votes":{"agree":139,"disagree":9,"pass":12,"seen":160},"byGroup":{"0":{"agree":67,"disagree":0,"pass":3,"seen":70},"1":{"agree":33,"disagree":2,"pass":6,"seen":41},"2":{"agree":38,"disagree":0,"pass":2,"seen":40},"3":{"agree":1,"disagree":7,"pass":1,"seen":9}}},{"tid":30,"text":"We should not implement a UBI until we have a well funded ‘Swedish style’ social welfare system with allowances for the most vulnerable, more generous employment laws and free university education","moderated":1,"votes":{"agree":32,"disagree":93,"pass":34,"seen":159},"byGroup":{"0":{"agree":17,"disagree":40,"pass":13,"seen":70},"1":{"agree":8,"disagree":20,"pass":12,"seen":40},"2":{"agree":4,"disagree":30,"pass":6,"seen":40},"3":{"agree":3,"disagree":3,"pass":3,"seen":9}}},{"tid":42,"text":"I am self employed or own a business","moderated":1,"votes":{"agree":40,"disagree":108,"pass":11,"seen":159},"byGroup":{"0":{"agree":19,"disagree":50,"pass":1,"seen":70},"1":{"agree":7,"disagree":29,"pass":4,"seen":40},"2":{"agree":11,"disagree":25,"pass":4,"seen":40},"3":{"agree":3,"disagree":4,"pass":2,"seen":9}}},{"tid":29,"text":"Focusing resources on UBI rather than on pooled risk-sharing mechanisms will encourage people to provide for themselves with their income rather than promoting social solidarity.","moderated":1,"votes":{"agree":45,"disagree":43,"pass":71,"seen":159},"byGroup":{"0":{"agree":17,"disagree":25,"pass":28,"seen":70},"1":{"agree":14,"disagree":6,"pass":21,"seen":41},"2":{"agree":12,"disagree":8,"pass":19,"seen":39},"3":{"agree":2,"disagree":4,"pass":3,"seen":9}}},{"tid":26,"text":"A UBI could improve the bargaining positions of the most vulnerable workers by giving them more power to leave or negotiate.","moderated":1,"votes":{"agree":143,"disagree":6,"pass":10,"seen":159},"byGroup":{"0":{"agree":66,"disagree":0,"pass":3,"seen":69},"1":{"agree":33,"disagree":2,"pass":5,"seen":40},"2":{"agree":40,"disagree":0,"pass":1,"seen":41},"3":{"agree":4,"disagree":4,"pass":1,"seen":9}}},{"tid":24,"text":"The financial security of a UBI would give the least well off a better chance to climb the economic ladder.\n","moderated":1,"votes":{"agree":139,"disagree":14,"pass":6,"seen":159},"byGroup":{"0":{"agree":68,"disagree":0,"pass":2,"seen":70},"1":{"agree":31,"disagree":7,"pass":4,"seen":42},"2":{"agree":38,"disagree":0,"pass":0,"seen":38},"3":{"agree":2,"disagree":7,"pass":0,"seen":9}}},{"tid":23,"text":"A UBI must not completely replace the current welfare system as there are still vulnerable people in need of additional support.","moderated":1,"votes":{"agree":117,"disagree":24,"pass":18,"seen":159},"byGroup":{"0":{"agree":57,"disagree":6,"pass":7,"seen":70},"1":{"agree":22,"disagree":10,"pass":6,"seen":38},"2":{"agree":35,"disagree":4,"pass":3,"seen":42},"3":{"agree":3,"disagree":4,"pass":2,"seen":9}}},{"tid":22,"text":"Direct contributions to GDP through paid work are a poor measure of people’s overall value to our society and economy.\n","moderated":1,"votes":{"agree":144,"disagree":8,"pass":7,"seen":159},"byGroup":{"0":{"agree":70,"disagree":0,"pass":0,"seen":70},"1":{"agree":33,"disagree":4,"pass":4,"seen":41},"2":{"agree":37,"disagree":0,"pass":2,"seen":39},"3":{"agree":4,"disagree":4,"pass":1,"seen":9}}},{"tid":17,"text":"UBI combined with economic austerity and welfare cuts could mean that individuals are left to pay for essential services (eg housing) at fluctuating market rates and have even less purchasing power.","moderated":1,"votes":{"agree":46,"disagree":61,"pass":52,"seen":159},"byGroup":{"0":{"agree":18,"disagree":31,"pass":21,"seen":70},"1":{"agree":13,"disagree":12,"pass":14,"seen":39},"2":{"agree":9,"disagree":17,"pass":15,"seen":41},"3":{"agree":6,"disagree":1,"pass":2,"seen":9}}},{"tid":5,"text":"A Universal Basic Income would better facilitate and recognise unpaid work such as care for the elderly, children, disabled people or other volunteer work which benefits society.","moderated":1,"votes":{"agree":150,"disagree":8,"pass":1,"seen":159},"byGroup":{"0":{"agree":70,"disagree":0,"pass":0,"seen":70},"1":{"agree":36,"disagree":3,"pass":0,"seen":39},"2":{"agree":41,"disagree":0,"pass":0,"seen":41},"3":{"agree":3,"disagree":5,"pass":1,"seen":9}}},{"tid":21,"text":"The vast majority of New Zealanders believe in the value of work and desire to be a valued, respected and contributing member of society in some way.","moderated":1,"votes":{"agree":147,"disagree":4,"pass":7,"seen":158},"byGroup":{"0":{"agree":69,"disagree":0,"pass":1,"seen":70},"1":{"agree":36,"disagree":2,"pass":2,"seen":40},"2":{"agree":37,"disagree":0,"pass":2,"seen":39},"3":{"agree":5,"disagree":2,"pass":2,"seen":9}}},{"tid":41,"text":"I am currently working","moderated":1,"votes":{"agree":105,"disagree":40,"pass":12,"seen":157},"byGroup":{"0":{"agree":47,"disagree":21,"pass":2,"seen":70},"1":{"agree":27,"disagree":6,"pass":6,"seen":39},"2":{"agree":23,"disagree":13,"pass":3,"seen":39},"3":{"agree":8,"disagree":0,"pass":1,"seen":9}}},{"tid":38,"text":"I am receiving or have received some form of WINZ allowance","moderated":1,"votes":{"agree":64,"disagree":78,"pass":15,"seen":157},"byGroup":{"0":{"agree":27,"disagree":38,"pass":5,"seen":70},"1":{"agree":16,"disagree":17,"pass":5,"seen":38},"2":{"agree":18,"disagree":19,"pass":3,"seen":40},"3":{"agree":3,"disagree":4,"pass":2,"seen":9}}},{"tid":25,"text":"UBI should not be funded by higher personal income taxes but rather by targeting tax avoiders and extractive users of our shared common resources.","moderated":1,"votes":{"agree":96,"disagree":33,"pass":28,"seen":157},"byGroup":{"0":{"agree":48,"disagree":12,"pass":10,"seen":70},"1":{"agree":19,"disagree":10,"pass":11,"seen":40},"2":{"agree":27,"disagree":7,"pass":4,"seen":38},"3":{"agree":2,"disagree":4,"pass":3,"seen":9}}},{"tid":16,"text":"Under a UBI the stigma of income support would be reduced as more people would see it as practical to their own financial security.","moderated":1,"votes":{"agree":141,"disagree":9,"pass":7,"seen":157},"byGroup":{"0":{"agree":67,"disagree":1,"pass":1,"seen":69},"1":{"agree":33,"disagree":2,"pass":4,"seen":39},"2":{"agree":39,"disagree":0,"pass":1,"seen":40},"3":{"agree":2,"disagree":6,"pass":1,"seen":9}}},{"tid":4,"text":"The Government must respect our ‘economic rights’ to have the means to access basic necessities set out in the UN declaration of Human Rights 1948.","moderated":1,"votes":{"agree":140,"disagree":7,"pass":10,"seen":157},"byGroup":{"0":{"agree":68,"disagree":0,"pass":1,"seen":69},"1":{"agree":30,"disagree":4,"pass":5,"seen":39},"2":{"agree":38,"disagree":0,"pass":2,"seen":40},"3":{"agree":4,"disagree":3,"pass":2,"seen":9}}},{"tid":37,"text":"I live in a city","moderated":1,"votes":{"agree":110,"disagree":34,"pass":12,"seen":156},"byGroup":{"0":{"agree":42,"disagree":23,"pass":5,"seen":70},"1":{"agree":31,"disagree":2,"pass":5,"seen":38},"2":{"agree":32,"disagree":6,"pass":1,"seen":39},"3":{"agree":5,"disagree":3,"pass":1,"seen":9}}},{"tid":31,"text":"We need more public debate about the UBI including wider discussion of how we should gather and employ our nation’s financial resources","moderated":1,"votes":{"agree":143,"disagree":8,"pass":5,"seen":156},"byGroup":{"0":{"agree":67,"disagree":1,"pass":1,"seen":69},"1":{"agree":31,"disagree":4,"pass":3,"seen":38},"2":{"agree":37,"disagree":2,"pass":1,"seen":40},"3":{"agree":8,"disagree":1,"pass":0,"seen":9}}},{"tid":13,"text":"The increase of the basic income over time should be linked to economic and productivity gains on top of inflation indexation in order to more fairly share the wealth of the growing economy.","moderated":1,"votes":{"agree":123,"disagree":13,"pass":20,"seen":156},"byGroup":{"0":{"agree":62,"disagree":2,"pass":5,"seen":69},"1":{"agree":27,"disagree":3,"pass":8,"seen":38},"2":{"agree":30,"disagree":3,"pass":7,"seen":40},"3":{"agree":4,"disagree":5,"pass":0,"seen":9}}},{"tid":10,"text":"Universal Basic Income should be funded by cuts to harmful spending such as military budgets, subsidies to agribusiness and the fossil fuel industry.","moderated":1,"votes":{"agree":97,"disagree":27,"pass":32,"seen":156},"byGroup":{"0":{"agree":56,"disagree":6,"pass":7,"seen":69},"1":{"agree":14,"disagree":10,"pass":15,"seen":39},"2":{"agree":26,"disagree":4,"pass":9,"seen":39},"3":{"agree":1,"disagree":7,"pass":1,"seen":9}}},{"tid":28,"text":"A UBI will encourage people to create and share products and information for the public good.","moderated":1,"votes":{"agree":121,"disagree":14,"pass":20,"seen":155},"byGroup":{"0":{"agree":64,"disagree":0,"pass":6,"seen":70},"1":{"agree":19,"disagree":5,"pass":10,"seen":34},"2":{"agree":37,"disagree":1,"pass":4,"seen":42},"3":{"agree":1,"disagree":8,"pass":0,"seen":9}}},{"tid":20,"text":"A good UBI policy would be one in which people have more expendable income as this will benefit the local economy and small businesses.","moderated":1,"votes":{"agree":123,"disagree":14,"pass":18,"seen":155},"byGroup":{"0":{"agree":61,"disagree":3,"pass":6,"seen":70},"1":{"agree":26,"disagree":3,"pass":8,"seen":37},"2":{"agree":34,"disagree":2,"pass":3,"seen":39},"3":{"agree":2,"disagree":6,"pass":1,"seen":9}}},{"tid":15,"text":"People with an unconditional income would make more rational and sensible decisions because they would not live under the threat of absolute destitution.","moderated":1,"votes":{"agree":134,"disagree":12,"pass":9,"seen":155},"byGroup":{"0":{"agree":66,"disagree":1,"pass":2,"seen":69},"1":{"agree":31,"disagree":4,"pass":3,"seen":38},"2":{"agree":36,"disagree":0,"pass":3,"seen":39},"3":{"agree":1,"disagree":7,"pass":1,"seen":9}}},{"tid":9,"text":"A universal basic income must be set at a level that matches the current allowances of the worst off so that means tested benefits can be eliminated to save on administration costs of WINZ.","moderated":1,"votes":{"agree":102,"disagree":17,"pass":36,"seen":155},"byGroup":{"0":{"agree":48,"disagree":4,"pass":18,"seen":70},"1":{"agree":23,"disagree":6,"pass":8,"seen":37},"2":{"agree":28,"disagree":3,"pass":8,"seen":39},"3":{"agree":3,"disagree":4,"pass":2,"seen":9}}},{"tid":7,"text":"A Universal Basic Income will be necessary to protect millions of working people from the worst effects of insecure employment caused by new technology.","moderated":1,"votes":{"agree":127,"disagree":13,"pass":15,"seen":155},"byGroup":{"0":{"agree":68,"disagree":0,"pass":2,"seen":70},"1":{"agree":21,"disagree":6,"pass":9,"seen":36},"2":{"agree":38,"disagree":0,"pass":2,"seen":40},"3":{"agree":0,"disagree":7,"pass":2,"seen":9}}},{"tid":2,"text":"An unconditional income support system would eliminate the problem of people who fall through the cracks of the current complicated and conditional benefit system. \n","moderated":1,"votes":{"agree":138,"disagree":12,"pass":5,"seen":155},"byGroup":{"0":{"agree":69,"disagree":0,"pass":1,"seen":70},"1":{"agree":28,"disagree":4,"pass":3,"seen":35},"2":{"agree":40,"disagree":1,"pass":0,"seen":41},"3":{"agree":1,"disagree":7,"pass":1,"seen":9}}},{"tid":39,"text":"I am male","moderated":1,"votes":{"agree":104,"disagree":40,"pass":10,"seen":154},"byGroup":{"0":{"agree":47,"disagree":21,"pass":2,"seen":70},"1":{"agree":23,"disagree":8,"pass":4,"seen":35},"2":{"agree":27,"disagree":11,"pass":2,"seen":40},"3":{"agree":7,"disagree":0,"pass":2,"seen":9}}},{"tid":19,"text":"UBI could advance public health as with more time, people will grow and prepare more nutritious food, will be less stressed and will be able to afford more health interventions.","moderated":1,"votes":{"agree":114,"disagree":20,"pass":20,"seen":154},"byGroup":{"0":{"agree":62,"disagree":2,"pass":6,"seen":70},"1":{"agree":18,"disagree":7,"pass":10,"seen":35},"2":{"agree":34,"disagree":2,"pass":4,"seen":40},"3":{"agree":0,"disagree":9,"pass":0,"seen":9}}},{"tid":18,"text":"Some people are simply lazy so providing them with a foundational amount of money to cover basic needs like food, shelter, medical costs would mean they would just stop working or being productive altogether.","moderated":1,"votes":{"agree":33,"disagree":115,"pass":6,"seen":154},"byGroup":{"0":{"agree":7,"disagree":59,"pass":3,"seen":69},"1":{"agree":11,"disagree":23,"pass":3,"seen":37},"2":{"agree":6,"disagree":33,"pass":0,"seen":39},"3":{"agree":9,"disagree":0,"pass":0,"seen":9}}},{"tid":12,"text":"The actual cost of universal basic income to the taxpayer is their increase in tax payments minus what they receive back in basic income payments. \n","moderated":1,"votes":{"agree":95,"disagree":23,"pass":36,"seen":154},"byGroup":{"0":{"agree":45,"disagree":8,"pass":16,"seen":69},"1":{"agree":20,"disagree":6,"pass":11,"seen":37},"2":{"agree":26,"disagree":4,"pass":9,"seen":39},"3":{"agree":4,"disagree":5,"pass":0,"seen":9}}},{"tid":34,"text":"I am under 30 years of age","moderated":1,"votes":{"agree":18,"disagree":127,"pass":8,"seen":153},"byGroup":{"0":{"agree":8,"disagree":60,"pass":2,"seen":70},"1":{"agree":5,"disagree":27,"pass":2,"seen":34},"2":{"agree":5,"disagree":33,"pass":2,"seen":40},"3":{"agree":0,"disagree":7,"pass":2,"seen":9}}},{"tid":40,"text":"I am Female","moderated":1,"votes":{"agree":43,"disagree":97,"pass":12,"seen":152},"byGroup":{"0":{"agree":22,"disagree":45,"pass":3,"seen":70},"1":{"agree":9,"disagree":20,"pass":4,"seen":33},"2":{"agree":12,"disagree":25,"pass":3,"seen":40},"3":{"agree":0,"disagree":7,"pass":2,"seen":9}}},{"tid":32,"text":"I am 55 years of age or older","moderated":1,"votes":{"agree":55,"disagree":87,"pass":10,"seen":152},"byGroup":{"0":{"agree":26,"disagree":40,"pass":3,"seen":69},"1":{"agree":11,"disagree":22,"pass":3,"seen":36},"2":{"agree":15,"disagree":21,"pass":2,"seen":38},"3":{"agree":3,"disagree":4,"pass":2,"seen":9}}},{"tid":1,"text":"We need to streamline the inefficiency and wasteful bureaucracy of our current tax and benefits systems.","moderated":1,"votes":{"agree":134,"disagree":6,"pass":12,"seen":152},"byGroup":{"0":{"agree":64,"disagree":0,"pass":5,"seen":69},"1":{"agree":26,"disagree":3,"pass":6,"seen":35},"2":{"agree":36,"disagree":2,"pass":1,"seen":39},"3":{"agree":8,"disagree":1,"pass":0,"seen":9}}},{"tid":60,"text":"Increasing the UBI should take precedence over minimum wage increases as employment becomes less secure","moderated":1,"votes":{"agree":31,"disagree":15,"pass":10,"seen":56},"byGroup":{"0":{"agree":0,"disagree":0,"pass":1,"seen":1},"1":{"agree":6,"disagree":5,"pass":0,"seen":11},"2":{"agree":25,"disagree":6,"pass":9,"seen":40},"3":{"agree":0,"disagree":4,"pass":0,"seen":4}}},{"tid":59,"text":"We should encourage reduced working hours and job sharing alongside UBI so that employment is more equitably spread and the UBI supplements wages.","moderated":1,"votes":{"agree":49,"disagree":6,"pass":1,"seen":56},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":8,"disagree":2,"pass":0,"seen":10},"2":{"agree":39,"disagree":1,"pass":1,"seen":41},"3":{"agree":1,"disagree":3,"pass":0,"seen":4}}},{"tid":63,"text":"UBI has clear benefits, but like most major policy decisions it also has risks. This does not mean we should not go ahead with it, but that we need to plan to manage any risks that arise.","moderated":1,"votes":{"agree":46,"disagree":6,"pass":3,"seen":55},"byGroup":{"0":{"agree":0,"disagree":0,"pass":1,"seen":1},"1":{"agree":8,"disagree":1,"pass":0,"seen":9},"2":{"agree":38,"disagree":2,"pass":1,"seen":41},"3":{"agree":0,"disagree":3,"pass":1,"seen":4}}},{"tid":65,"text":"UBI could be funded by some form of government quantitative easing rather than by taxes.","moderated":1,"votes":{"agree":25,"disagree":15,"pass":14,"seen":54},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":4,"disagree":3,"pass":2,"seen":9},"2":{"agree":20,"disagree":8,"pass":12,"seen":40},"3":{"agree":0,"disagree":4,"pass":0,"seen":4}}},{"tid":66,"text":"Assuming that the NZ economy produces enough to support all New Zealanders, a UBI seems the fairest way to provide that basic support","moderated":1,"votes":{"agree":47,"disagree":5,"pass":1,"seen":53},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":6,"disagree":1,"pass":1,"seen":8},"2":{"agree":40,"disagree":0,"pass":0,"seen":40},"3":{"agree":0,"disagree":4,"pass":0,"seen":4}}},{"tid":64,"text":"With unemployment projected to reach 40% in the next 10 - 20 years we need something in place ready for that to happen","moderated":1,"votes":{"agree":47,"disagree":3,"pass":2,"seen":52},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":3,"disagree":2,"pass":2,"seen":7},"2":{"agree":40,"disagree":0,"pass":0,"seen":40},"3":{"agree":3,"disagree":1,"pass":0,"seen":4}}},{"tid":62,"text":"It is possible that provision of a UBI could be done in a manner which does not increase overall government expenditure","moderated":1,"votes":{"agree":34,"disagree":9,"pass":9,"seen":52},"byGroup":{"0":{"agree":0,"disagree":0,"pass":1,"seen":1},"1":{"agree":3,"disagree":3,"pass":1,"seen":7},"2":{"agree":31,"disagree":3,"pass":6,"seen":40},"3":{"agree":0,"disagree":3,"pass":1,"seen":4}}},{"tid":67,"text":"UBI would need to be adequately funded to include investment into treatment of addictions.","moderated":1,"votes":{"agree":22,"disagree":16,"pass":13,"seen":51},"byGroup":{"0":{"agree":0,"disagree":0,"pass":1,"seen":1},"1":{"agree":4,"disagree":0,"pass":3,"seen":7},"2":{"agree":17,"disagree":13,"pass":9,"seen":39},"3":{"agree":1,"disagree":3,"pass":0,"seen":4}}},{"tid":61,"text":"UBI is important to a fully functioning democracy. Voters cannot give due attention to politics when they have to worry about where the next meal is coming from or whether they will be able to pay their electricity bill.","moderated":1,"votes":{"agree":43,"disagree":6,"pass":1,"seen":50},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":5,"disagree":2,"pass":0,"seen":7},"2":{"agree":37,"disagree":1,"pass":0,"seen":38},"3":{"agree":0,"disagree":3,"pass":1,"seen":4}}},{"tid":70,"text":"We should adopt these four steps recommended by BINZ to progress a UBI:\n1. Replace the jobseekers benefit with an income neutral UBI; 2. index this UBI by inflation, growth, and increases in productivity; 3. introduce a kids' basic income; 4. expand on the Government's voluntary relocation scheme to make replacing the accommodation supplement more feasible in the future.","moderated":1,"votes":{"agree":36,"disagree":6,"pass":7,"seen":49},"byGroup":{"0":{"agree":0,"disagree":1,"pass":0,"seen":1},"1":{"agree":4,"disagree":1,"pass":3,"seen":8},"2":{"agree":31,"disagree":1,"pass":4,"seen":36},"3":{"agree":1,"disagree":3,"pass":0,"seen":4}}},{"tid":69,"text":"Everyone deserves the opportunity to better themselves, but greed is an addiction. Let's stop debating 'min wage' and discuss a 'max wage'!","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":1,"disagree":0,"pass":0,"seen":1},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":56,"text":"There are ways to fund a UBI apart from tax e.g. some sort of  government quantatitive easing as in Bill Mitchell's Modern Monetary Theory","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":68,"text":"Society is equally indispensable in the creation of economic wealth as the initiating party in all cases.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":1,"disagree":0,"pass":0,"seen":1},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":58,"text":"Assuming that the NZ economy produces enough to support all New Zealanders, a UBI seems the fairest way to provide that basic support.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":57,"text":"With UBI people's contribution to communities and the society as a whole will increase rather than decrease","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":55,"text":"It is possible that provision of a UBI could be done in a manner which does not increase overall government expenditure.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":54,"text":"UBI has clear benefits, but also risks, like most major policy decisions. We should go ahead with it and plan to manage risks that arise.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":53,"text":"So dumb really is if it happens then i will just quit my job and do nothing all day kinda like people on welfare","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":52,"text":"With unemployment projected to reach 40% in the next 10 - 20 years we need something in place ready for that to happen.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":51,"text":"Government control","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":50,"text":"Streamlining the inefficiency and wasteful bureaucracy of our current tax and benefits system will not solve the underlying social problems","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":1,"disagree":0,"pass":0,"seen":1},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":49,"text":"A Sovereign Money System would mean that a UBI would actually become the funding for the economy.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":48,"text":"People want jobs. UBI needs to be accompanied by shared work for all newly advertised positions. UBI is then a supplement to half a job.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":47,"text":"A UBI might be a citizens' dividend distributed from 'rent' (not 'tax') paid by owners of private property for their use of social capital.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":46,"text":"Continually develop budget so: 1, UBI is well funded; 2, wastage on addictions is avoided.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":45,"text":"Automation and artificial intelligence are going to devastate the job market. Employment will no longer be an option for most people.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":44,"text":"A UBI that covers the basics will have a positive effect. It will help rebuild communities throughout the country and encourage sharing.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":1,"disagree":0,"pass":0,"seen":1},"1":{"agree":0,"disagree":0,"pass":0,"seen":0},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}},{"tid":43,"text":"I have advocated for some time that the minimum wage needs to be increased substantially. I now realise a UBI is a much better way.","moderated":0,"votes":{"agree":1,"disagree":0,"pass":0,"seen":1},"byGroup":{"0":{"agree":0,"disagree":0,"pass":0,"seen":0},"1":{"agree":1,"disagree":0,"pass":0,"seen":1},"2":{"agree":0,"disagree":0,"pass":0,"seen":0},"3":{"agree":0,"disagree":0,"pass":0,"seen":0}}}]}