{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "AWS_REGION",
    "EXA_API_KEY",
    "EXA_WEBHOOK_SECRET",
    "NEXT_PUBLIC_PROJECT_ROOT",
    "NODE_ENV",
    "POLICY_CLUSTER_ARN",
    "POLICY_DATABASE",
    "POLICY_DATABASE_URL",
    "POLICY_SECRET_ARN",
    "TYPESET_UPLOADS_BUCKET",
    "USCENSUS_API_KEY"
  ]
}
